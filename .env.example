# Groq API Configuration (required for the LLM features)
GROQ_API_KEY=
# Any Groq chat model id; defaults to openai/gpt-oss-120b
GROQ_MODEL=

# Neo4j NoSQL Graph Database Configuration
# docker-compose.yml uses NEO4J_PASSWORD for the container too
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=research123
NEO4J_DATABASE=neo4j

# MongoDB Document Store (optional; leave MONGODB_URI blank to disable)
# Local: mongodb://localhost:27017  Atlas: mongodb+srv://<user>:<password>@<cluster>/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=researchiq

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional External API Keys (leave blank if unused)
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
NCBI_API_KEY=
CROSSREF_MAILTO=
